<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The App Group lets the widget read the snapshot the app writes into the
	     shared container. Bare `group.` form on iOS, matching
	     CompHunt-iOS.entitlements. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.nhannht.ncomphunt</string>
	</array>
</dict>
</plist>
